{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "college-crm",
  "main": "server/index.ts",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"]},
  "d1_databases": [{"binding": "DB", "database_name": "college-crm", "database_id": "local-only", "migrations_dir": "migrations"}],
  "vars": {"APP_NAME": "מרחב · מכללות"},
  "observability": {"enabled": true}
}
